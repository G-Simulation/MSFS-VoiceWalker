<?xml version="1.0" encoding="UTF-8"?>
<!--
  VoiceWalker — WiX-v7-Installer-Definition.

  Baut eine MSI, die:
    - VoiceWalker.exe nach %LOCALAPPDATA%\VoiceWalker\ installiert
    - den Python-MSFS-Integrator (VoiceWalker-Setup.exe) mitliefert;
      der Integrator bringt das Community-Folder-Addon selbst mit (embedded)
      und verteilt es beim Install in die MSFS-Community-Ordner
    - Start-Menu- und Desktop-Verknuepfung anlegt (Desktop optional)
    - sich im Add/Remove-Programs registriert
    - am Ende den Integrator fuer MSFS-Integration startet

  Bitte die UpgradeCode-GUID NICHT aendern — sie identifiziert das Produkt
  ueber alle Versionen hinweg und macht saubere Upgrades moeglich.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="VoiceWalker"
      Manufacturer="G-Simulations"
      Version="0.2.1.0"
      UpgradeCode="F9E8D7C6-B5A4-4392-8170-6F5E4D3C2B1A"
      Scope="perUser"
      Language="1031"
      Codepage="1252"
      Compressed="yes">

    <SummaryInformation Description="VoiceWalker — Proximity-Voice für MSFS 2024" />

    <!-- Saubere Upgrades: vorherige Version wird automatisch entfernt -->
    <MajorUpgrade
        DowngradeErrorMessage="Eine neuere Version von [ProductName] ist bereits installiert." />

    <!-- Alles in eine eingebettete CAB packen, damit die MSI eine einzelne Datei ist -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ========================================================
         Auto-Close laufender App-Instanzen.
         Wenn der User gerade VoiceWalker laufen hat (Tray-Icon aktiv) und
         ein Update einspielt, blockt Windows den File-Tausch wegen offener
         File-Handles. Util:CloseApplication schickt zuerst WM_CLOSE
         (sauberes Quit, Tray-Quit-Pfad), wenn das nicht klappt, wird der
         Prozess hart terminiert. PromptToContinue=no = User wird nicht
         gefragt, alles laeuft silent durch.
         ======================================================== -->
    <util:CloseApplication
        Id="CloseVoiceWalkerExe"
        Target="VoiceWalker.exe"
        CloseMessage="yes"
        PromptToContinue="no"
        TerminateProcess="5"
        RebootPrompt="no"
        EndSessionMessage="yes" />
    <util:CloseApplication
        Id="CloseIntegratorExe"
        Target="VoiceWalker-Integrator.exe"
        CloseMessage="yes"
        PromptToContinue="no"
        TerminateProcess="5"
        RebootPrompt="no"
        EndSessionMessage="yes" />

    <!-- ========================================================
         WebView2-Runtime-Detection.
         Inspect die offiziellen Edge-Update-Registry-Keys (siehe MS-Doku
         https://learn.microsoft.com/en-us/microsoft-edge/webview2/concepts/distribution).
         Wenn 'pv' fehlt oder leer/0.0.0.0 ist → Runtime nicht installiert,
         und unser Bootstrapper-CustomAction laeuft (siehe unten).
         ======================================================== -->
    <Property Id="WEBVIEW2_PV_HKLM_64">
      <RegistrySearch Id="WV2HKLM64"
                      Root="HKLM"
                      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" />
    </Property>
    <Property Id="WEBVIEW2_PV_HKCU">
      <RegistrySearch Id="WV2HKCU"
                      Root="HKCU"
                      Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
                      Name="pv" Type="raw" />
    </Property>

    <!-- Icon, das in Add/Remove Programs + Start-Menu + Desktop-Shortcut
         erscheint. Liegt in packaging/app-icon.ico (Multi-Size 16..256 px),
         generiert von packaging/build-app-icon.py. Unabhaengig vom EXE-Rebuild
         — d.h. Icon-Aenderung braucht nur "MSI bauen", nicht PyInstaller. -->
    <Icon Id="AppIcon.ico" SourceFile="..\packaging\app-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/G-Simulation/VoiceWalker" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/G-Simulation/VoiceWalker" />

    <!-- ========================================================
         Verzeichnis-Struktur
         Per-User-Install in %LOCALAPPDATA%\VoiceWalker
         ======================================================== -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="VoiceWalker" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="VoiceWalker" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ========================================================
         Features
         ======================================================== -->
    <Feature Id="MainFeature" Title="Anwendung" Level="1"
             Description="VoiceWalker selbst. Erforderlich.">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <!-- RemoveInstallFolder ist Teil von AppComponents — keine
           weiteren ComponentRefs noetig. -->
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop-Verknüpfung" Level="1"
             Description="Legt ein Icon auf dem Desktop ab.">
      <ComponentRef Id="DesktopShortcutComp" />
    </Feature>

    <!-- ========================================================
         Komponenten: die eigentlichen Dateien.
         Per-User-Install: File darf nicht KeyPath sein (ICE38), stattdessen
         ein HKCU-Registry-Eintrag pro Komponente.
         ======================================================== -->
    <!--
      GUIDs: stabil ueber alle Versionen. "*" kann WiX nicht auto-generieren,
      wenn eine Komponente sowohl Datei als auch Registry-KeyPath enthaelt.
      Nur reine Registry-Komponenten (RemoveFolder-Dummys) duerfen "*" haben.
    -->
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">

      <Component Id="MainExe" Guid="A1B2C301-0001-4000-8000-000000000001">
        <File Id="VoiceWalkerExe" Source="..\dist\VoiceWalker.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="MainExe" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="IntegratorExe" Guid="A1B2C301-0001-4000-8000-000000000002">
        <File Id="IntegratorExeFile"
              Source="..\dist\VoiceWalker-Setup.exe"
              Name="VoiceWalker-Integrator.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="Integrator" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LicenseFile" Guid="A1B2C301-0001-4000-8000-000000000003">
        <File Source="..\LICENSE" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="License" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="NoticeFile" Guid="A1B2C301-0001-4000-8000-000000000004">
        <File Source="..\NOTICE" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="Notice" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ReadmeFile" Guid="A1B2C301-0001-4000-8000-000000000005">
        <File Source="..\README.md" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="Readme" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- WebView2-Runtime-Bootstrapper. Microsofts Online-Installer (~2 MB)
           wird mitgeliefert, damit User ohne WebView2-Runtime offline durch
           den Install kommen. Beim Install ruft die InstallWebView2-Custom-
           Action diesen File mit /silent /install auf — aber nur wenn die
           Runtime fehlt (Property-Conditions auf WEBVIEW2_PV_*).
           Datei wird vom wixproj-Target DownloadWebView2Bootstrapper geholt. -->
      <Component Id="WebView2BootstrapperFile" Guid="A1B2C301-0001-4000-8000-000000000006">
        <File Id="WebView2BootstrapperExe"
              Source="..\packaging\MicrosoftEdgeWebview2Setup.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="WebView2Bootstrapper" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Reine Registry-Komponente, darf * haben -->
      <Component Id="RemoveInstallFolder" Guid="*">
        <RemoveFolder Id="RemoveInstallFolder"
                      Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\G-Simulation\VoiceWalker\Components"
                       Name="RemoveInstallFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <!-- Start-Menu-Verknuepfung (immer mitinstalliert).
         ShortcutProperty System.AppUserModel.ID verlinkt den Shortcut mit
         unserer Toast-App-ID. Ohne diese Property filtert Win10/11 unsere
         Modern-Toasts oft (Action-Center sieht keine "echte" App-Verknuepfung
         und droppt die Notification). MUSS exakt mit der ID matchen, die
         tray.py per SetCurrentProcessExplicitAppUserModelID setzt. -->
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="AppStartMenuShortcut"
                Name="VoiceWalker"
                Description="Proximity-Voice für MSFS 2024"
                Target="[INSTALLFOLDER]VoiceWalker.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" IconIndex="0">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="GSimulations.VoiceWalker" />
      </Shortcut>
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\G-Simulation\VoiceWalker"
                     Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Desktop-Verknuepfung (optionales Feature). Selbe AppUserModelID-
         Property — beide Shortcuts muessen die ID haben, damit Windows
         egal von wo der User startet die selbe Toast-App-ID kennt. -->
    <Component Id="DesktopShortcutComp" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="AppDesktopShortcut"
                Name="VoiceWalker"
                Description="Proximity-Voice für MSFS 2024"
                Target="[INSTALLFOLDER]VoiceWalker.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" IconIndex="0">
        <ShortcutProperty Key="System.AppUserModel.ID" Value="GSimulations.VoiceWalker" />
      </Shortcut>
      <RegistryValue Root="HKCU"
                     Key="Software\G-Simulation\VoiceWalker"
                     Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- ========================================================
         Custom Action: MSFS-Integrator am Ende ausfuehren
         (registriert Community-Folder + exe.xml)
         ======================================================== -->
    <!-- WebView2-Runtime nachinstallieren wenn fehlt. Bootstrapper laeuft
         silent, blockiert bis fertig (Return="ignore" — falls Bootstrapper
         crasht, install bricht NICHT ab; pywebview faellt dann auf
         Edge-Fallback zurueck). Schedule unten in InstallExecuteSequence. -->
    <CustomAction Id="InstallWebView2"
                  FileRef="WebView2BootstrapperExe"
                  ExeCommand="/silent /install"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="RunIntegrator"
                  FileRef="IntegratorExeFile"
                  ExeCommand=""
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <CustomAction Id="RunIntegratorUninstall"
                  FileRef="IntegratorExeFile"
                  ExeCommand="uninstall"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- VoiceWalker.exe nach erfolgreichem Install starten — die App zeigt
         beim ersten Lauf den Setup-Wizard (Mikrofon-Auswahl, Sprache,
         optionale Pro-Lizenz). asyncNoWait, damit MSI sofort weitergeht
         und die App im Hintergrund (Tray) laeuft. Impersonate=yes, sonst
         laeuft die App im SYSTEM-Kontext und nicht als User. -->
    <CustomAction Id="LaunchVoiceWalker"
                  FileRef="VoiceWalkerExe"
                  ExeCommand=""
                  Execute="deferred"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <!-- WebView2-Runtime VOR dem Integrator nachinstallieren — der Integrator
           braucht sie nicht direkt, aber die App selbst wird gleich danach
           gestartet (LaunchVoiceWalker) und braucht WebView2 fuer's pywebview-
           Window. Condition: nur wenn WEDER per-machine NOCH per-user 'pv'
           in der Registry steht (oder wenn er nur "0.0.0.0" ist = Stub). -->
      <Custom Action="InstallWebView2"
              After="InstallFiles"
              Condition="(NOT WEBVIEW2_PV_HKLM_64 OR WEBVIEW2_PV_HKLM_64=&quot;0.0.0.0&quot;) AND (NOT WEBVIEW2_PV_HKCU OR WEBVIEW2_PV_HKCU=&quot;0.0.0.0&quot;) AND (NOT Installed OR REINSTALL)" />
      <Custom Action="RunIntegrator"
              After="InstallWebView2"
              Condition="NOT Installed" />
      <Custom Action="LaunchVoiceWalker"
              After="RunIntegrator"
              Condition="NOT Installed" />
      <Custom Action="RunIntegratorUninstall"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ========================================================
         UI: Standard-Dialogfolge mit Lizenz-Seite + VoiceWalker-Branding.
         dialog-bg.bmp ist 493x312 (Welcome+Exit-Dialog), banner.bmp ist
         493x58 (oben in Folge-Dialogen). Beide werden zur Build-Zeit aus
         brand/-Assets generiert (siehe wixproj-Target GenerateInstallerImages).
         ======================================================== -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog-bg.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />

  </Package>
</Wix>
